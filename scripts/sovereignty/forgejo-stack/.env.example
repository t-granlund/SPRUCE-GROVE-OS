# Copy to .env and fill from the steward vault. NEVER commit the real .env.
FORGEJO_DOMAIN=git.sprucegrove.io
CI_DOMAIN=ci.sprucegrove.io
ACME_EMAIL=steward@sprucegrove.io

# Woodpecker agent/server shared secret — generate:
#   openssl rand -hex 32
WOODPECKER_AGENT_SECRET=replace-me

# Forgejo OAuth app values (create in Forgejo admin -> applications,
# redirect URI: https://ci.sprucegrove.io/user/auth/forgejo/callback)
WOODPECKER_CLIENT_ID=replace-me
WOODPECKER_CLIENT_SECRET=replace-me
